# ---------- Server ----------
PORT=5000
NODE_ENV=development

# ---------- Database ----------
# Your MongoDB Atlas connection string, for example:
# mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/servicehub?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_connection_string

# ---------- Authentication ----------
# Any long random string. Never share it or commit it.
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d

# ---------- Cloudinary (image uploads) ----------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---------- CORS: websites allowed to call this API ----------
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ---------- Only used by "npm run seed" ----------
ADMIN_EMAIL=admin@servicehub.com
ADMIN_PASSWORD=Admin@123
